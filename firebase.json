{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4002
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "apps/api/dist",
      "codebase": "api",
      "runtime": "nodejs22",
      "predeploy": [
        "npm run prepare:firebase"
      ]
    }
  ]
}

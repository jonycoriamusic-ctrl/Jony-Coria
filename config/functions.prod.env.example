# npm run prepare:firebase copies this into apps/api/dist/.env.jony-coria after building.
# Firebase injects GCLOUD_PROJECT automatically. FIREBASE_* keys are reserved.
APP_ENV=prod
DEMO_MODE=false
MEDIA_PROVIDER=cloudinary
FUNCTIONS_REGION=us-central1
# Preparation adds CLOUDINARY_CLOUD_NAME and CLOUDINARY_API_KEY from environment
# or the ignored .env.cloudinary.local file. API_SECRET is NEVER copied here:
# it must be bound through the host's secret manager.
# ALLOWED_ORIGINS=https://your-production-domain

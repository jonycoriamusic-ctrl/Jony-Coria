APP_ENV=non-prod
DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=non-prod
NEXT_PUBLIC_AUTH_MODE=demo
API_PORT=4000
API_ORIGIN=http://127.0.0.1:4000
